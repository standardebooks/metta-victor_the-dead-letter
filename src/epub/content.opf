		<dc:title id="title">The Dead Letter</dc:title>
		<meta property="file-as" refines="#title">Dead Letter, The</meta>
		<meta property="title-type" refines="#title">main</meta>
		<dc:title id="subtitle">An American Romance</dc:title>
		<meta property="file-as" refines="#subtitle">American Romance, An</meta>
		<meta property="title-type" refines="#subtitle">subtitle</meta>
		<dc:title id="fulltitle">The Dead Letter: An American Romance</dc:title>
